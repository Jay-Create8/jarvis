<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- 5.1: needed for the local WebSocket bridge (even on 127.0.0.1) -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- 5.1: Android 11+ hides other apps; without this, "app_öffnen" finds almost nothing -->
  <queries><intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent></queries>
  <application android:label="JARVIS Companion">
    <!-- Must be enabled MANUALLY by the user: Settings → Accessibility → JARVIS Companion -->
    <service android:name=".JarvisAccessibilityService" android:exported="false"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config" />
    </service>
  </application>
</manifest>
